# Copy to .env.local and fill in. Never commit real secrets.
# Only variables the code actually reads are listed; more are added with each integration.

# Public base URL used for sitemap/robots/canonical links
APP_URL=http://localhost:3000

# Manager notifications. Without EMAIL_PROVIDER the app runs in log mode:
# inquiries are saved and the email is only logged (not delivered).
EMAIL_PROVIDER=        # "resend" to send for real
EMAIL_API_KEY=
EMAIL_FROM=            # e.g. "gremu <noreply@your-domain>"
MANAGER_EMAIL=         # where new inquiries/orders are sent

# Database. Empty = embedded PGlite in .data/pglite (local development only).
# Set to a PostgreSQL URL (e.g. Supabase) for staging/production; migrations run automatically.
DATABASE_URL=

# Signs guest order links. Required in production — use a long random string.
APP_SECRET=

# Admin sign-in (interim, until Google sign-in with roles).
# Generate the hash: npm run admin:hash -- "a-long-unique-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Customer sign-in: Google OpenID Connect (scopes: openid email profile).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI, one per environment: ${APP_URL}/api/auth/google/callback
#   e.g. http://localhost:3000/api/auth/google/callback
# Without these the "Sign in with Google" button is shown as not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LOCAL DEVELOPMENT ONLY: "1" shows a test sign-in form (no Google) on /account/login.
# Ignored when NODE_ENV=production. Leave empty everywhere else.
AUTH_DEV_LOGIN=

# Payme (online payments). Without MERCHANT_ID + SECRET_KEY the Payme option is not offered.
# Endpoint for the Payme cabinet: ${APP_URL}/api/payments/payme, account field: order_id.
# See docs/PAYMENTS.md for sandbox testing and the test -> production checklist.
PAYME_MODE=test            # "test" or "production"
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=          # TEST key while PAYME_MODE=test, production key after onboarding
PAYME_CHECKOUT_URL=        # optional override of the hosted checkout base URL

# Click: interface only, not an active integration yet (see src/features/payments/click.ts).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# AI assistant (Gemini). Server-only key; without it the widget offers only the manager form.
# Key: https://aistudio.google.com/apikey  (restrict it to the Generative Language API)
GEMINI_API_KEY=
GEMINI_MODEL=              # optional, comma-separated fallback list; default: gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash

# Staff access to /admin via Google sign-in (comma-separated emails). Read on every request:
# removing an email revokes access immediately. ADMIN = full access; STAFF = orders, inquiries, products.
ADMIN_EMAILS=
STAFF_EMAILS=

# Seed the DEMO catalog into an empty database. Always on in development; never set it in production.
CATALOG_SEED_DEMO=

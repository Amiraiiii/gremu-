# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local mock-mode data (inquiries until the DB is connected)
/.data/

# Playwright MCP screenshots and logs from manual checks
/.playwright-mcp/

# test output and verification builds
/test-results/
/playwright-report/
/.next-build/

# local tooling, not part of the site
/.claude/settings.local.json
/.playwright-mcp/
/10k-websites-skill.zip
